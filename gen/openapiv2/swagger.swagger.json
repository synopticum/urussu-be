{
  "swagger": "2.0",
  "info": {
    "title": "urussu-be API",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "DotsService",
      "description": "DotsService serves map \"dot\" objects stored in PostgreSQL."
    },
    {
      "name": "AuthService",
      "description": "AuthService handles registration and login. Its endpoints are public —\nthe HTTP auth middleware skips everything under /api/v1/auth/."
    },
    {
      "name": "CommentsService",
      "description": "CommentsService serves user comments attached to map entities\n(dots, objects or paths)."
    },
    {
      "name": "ObjectsService",
      "description": "ObjectsService serves map \"object\" objects stored in PostgreSQL."
    },
    {
      "name": "PathsService",
      "description": "PathsService serves map \"path\" objects stored in PostgreSQL."
    }
  ],
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login authenticates a user and returns a signed JWT bearer token.",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "LoginRequest carries the credentials to authenticate with.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register creates a new user account with the \"user\" role.",
        "operationId": "AuthService_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RegisterResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "RegisterRequest carries the data needed to create an account.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RegisterRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/api/v1/comments": {
      "get": {
        "summary": "ListComments returns all comments of the entity given by entity_id.",
        "operationId": "CommentsService_ListComments",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListCommentsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "entityId",
            "description": "ID of the entity (dot, object or path) to list comments for. Required.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "CommentsService"
        ]
      },
      "post": {
        "summary": "CreateComment creates a comment on the entity given by entity_id and\nentity_type. The author is taken from the authenticated session.",
        "operationId": "CommentsService_CreateComment",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateCommentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1CreateCommentRequest"
            }
          }
        ],
        "tags": [
          "CommentsService"
        ]
      }
    },
    "/api/v1/dots": {
      "get": {
        "summary": "ListDots returns dots from the database.",
        "operationId": "DotsService_ListDots",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDotsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "Maximum number of dots to return. Defaults to 1000 when omitted.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "layer",
            "description": "Filter by layer name (e.g. \"1980\"). Returns dots from all layers when omitted.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "DotsService"
        ]
      }
    },
    "/api/v1/dots/{id}": {
      "get": {
        "summary": "GetDot returns a single dot by its ID.",
        "operationId": "DotsService_GetDot",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetDotResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "description": "ID of the dot to return.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DotsService"
        ]
      }
    },
    "/api/v1/objects": {
      "get": {
        "summary": "ListObjects returns objects from the database.",
        "operationId": "ObjectsService_ListObjects",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListObjectsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "Maximum number of objects to return. Defaults to 1000 when omitted.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "ObjectsService"
        ]
      }
    },
    "/api/v1/objects/{id}": {
      "get": {
        "summary": "GetObject returns a single object by its ID.",
        "operationId": "ObjectsService_GetObject",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetObjectResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "description": "ID of the object to return.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ObjectsService"
        ]
      }
    },
    "/api/v1/paths": {
      "get": {
        "summary": "ListPaths returns paths from the database.",
        "operationId": "PathsService_ListPaths",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPathsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "Maximum number of paths to return. Defaults to 1000 when omitted.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "PathsService"
        ]
      }
    },
    "/api/v1/paths/{id}": {
      "get": {
        "summary": "GetPath returns a single path by its ID.",
        "operationId": "PathsService_GetPath",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetPathResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "description": "ID of the path to return.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PathsService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Comment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "Author's display name, derived from the user's first and last name."
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "v1CommentEntityType": {
      "type": "string",
      "enum": [
        "COMMENT_ENTITY_TYPE_UNSPECIFIED",
        "COMMENT_ENTITY_TYPE_DOT",
        "COMMENT_ENTITY_TYPE_OBJECT",
        "COMMENT_ENTITY_TYPE_PATH"
      ],
      "default": "COMMENT_ENTITY_TYPE_UNSPECIFIED",
      "description": "CommentEntityType identifies the kind of entity a comment belongs to."
    },
    "v1CreateCommentRequest": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string",
          "description": "ID of the entity (dot, object or path) to comment on. Required."
        },
        "entityType": {
          "$ref": "#/definitions/v1CommentEntityType",
          "description": "Kind of the entity given by entity_id. Required."
        },
        "body": {
          "type": "string",
          "description": "Comment text. Required, max 240 characters."
        }
      }
    },
    "v1CreateCommentResponse": {
      "type": "object",
      "properties": {
        "comment": {
          "$ref": "#/definitions/v1Comment",
          "description": "The created comment, in the same shape as ListComments items."
        }
      }
    },
    "v1Dot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Image"
          }
        }
      }
    },
    "v1GetDotResponse": {
      "type": "object",
      "properties": {
        "dot": {
          "$ref": "#/definitions/v1Dot"
        }
      }
    },
    "v1GetObjectResponse": {
      "type": "object",
      "properties": {
        "object": {
          "$ref": "#/definitions/v1Object"
        }
      }
    },
    "v1GetPathResponse": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/definitions/v1Path"
        }
      }
    },
    "v1Image": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "Image is a photo of a map entity (dot, object or path) taken in a given year."
    },
    "v1ListCommentsResponse": {
      "type": "object",
      "properties": {
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Comment"
          }
        }
      }
    },
    "v1ListDotsResponse": {
      "type": "object",
      "properties": {
        "dots": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Dot"
          }
        }
      }
    },
    "v1ListObjectsResponse": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Object"
          }
        }
      }
    },
    "v1ListPathsResponse": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Path"
          }
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the account."
        },
        "password": {
          "type": "string",
          "description": "Plain-text password to verify against the stored bcrypt hash."
        }
      },
      "description": "LoginRequest carries the credentials to authenticate with."
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Signed JWT with sub/role/iat/exp claims."
        }
      },
      "description": "LoginResponse returns the token to send as \"Authorization: Bearer \u003ctoken\u003e\"."
    },
    "v1Object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "house": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "radius": {
          "type": "number",
          "format": "float",
          "description": "Radius of the object, when set."
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Point"
          },
          "description": "Polygon outline of the object on the map."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Image"
          }
        }
      }
    },
    "v1Path": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Point"
          },
          "description": "Polyline of the path on the map."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Image"
          }
        }
      }
    },
    "v1Point": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "format": "double"
        },
        "longitude": {
          "type": "number",
          "format": "double"
        }
      },
      "description": "Point is a position on the map."
    },
    "v1RegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the new account (case-insensitive, stored lowercased)."
        },
        "password": {
          "type": "string",
          "description": "Plain-text password, stored only as a bcrypt hash. Minimum 8 characters."
        },
        "firstName": {
          "type": "string",
          "description": "Given name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Family name of the user."
        }
      },
      "description": "RegisterRequest carries the data needed to create an account."
    },
    "v1RegisterResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User",
          "description": "The created user."
        }
      },
      "description": "RegisterResponse returns the created account. The password hash is never exposed."
    },
    "v1User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique ID of the user (UUID)."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user."
        },
        "role": {
          "type": "string",
          "description": "Access level of the user (\"user\" or \"admin\")."
        },
        "firstName": {
          "type": "string",
          "description": "Given name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "Family name of the user."
        }
      },
      "description": "User is the public view of an account — no password hash."
    }
  },
  "securityDefinitions": {
    "bearer": {
      "type": "apiKey",
      "description": "JWT as \"Bearer \u003ctoken\u003e\", obtained from /api/v1/auth/login.",
      "name": "Authorization",
      "in": "header"
    }
  }
}
