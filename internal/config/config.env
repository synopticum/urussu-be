# Single source of built-in defaults for urussu-be. Consumed by:
#   - the Go binary (embedded and parsed in internal/config/config.go)
#   - the Makefile (via include)
#   - docker compose (via --env-file, see the docker-up/docker-down targets)
# Real secrets belong in a gitignored .env, not in this committed file.
HTTP_PORT=8080
LOG_LEVEL=info
POSTGRES_USER=urussu
POSTGRES_PASSWORD=urussu
POSTGRES_DB=urussu_v2
POSTGRES_PORT=5432
# The DB host is intentionally NOT here: it is context-dependent —
# localhost for the binary and Makefile, db for the compose app service.
